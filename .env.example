# Al Hamra TAS — environment variables (placeholders only; never commit real values).
# Real secrets live in Supabase / Lovable, not in the repo.

# --- Supabase (client, build-time injected by Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Microsoft Entra ID (OIDC — authentication only) ---
# Consumed by the auth flow and the auth-callback edge function.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# --- M0.4 Notifications adapters (set in Supabase/Lovable secrets by ops) ---
# Microsoft Graph (Outlook email + Teams). GRAPH_SENDER_UPN = mailbox to send as.
GRAPH_SCOPES=
GRAPH_SENDER_UPN=
# SMS gateway (generic HTTP POST adapter).
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
