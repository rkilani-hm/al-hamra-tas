# Al Hamra TAS — environment variables (placeholders only; never commit real values).
# Real secrets live in Supabase / Lovable, not in the repo.

# --- Supabase (client, build-time injected by Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Microsoft Entra ID (OIDC — authentication only) ---
# Consumed by the auth flow and the auth-callback edge function.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# --- M0.4 Notifications adapters (set in Supabase/Lovable secrets by ops) ---
# Microsoft Graph (Outlook email + Teams). GRAPH_SENDER_UPN = mailbox to send as.
# M1.7 interview scheduling (dormant) reuses these — GRAPH_SCOPES must also include
# Calendars.ReadWrite and OnlineMeetings.ReadWrite to create Outlook events + Teams
# meetings. No new secret names are required beyond the ENTRA_*/GRAPH_* above.
GRAPH_SCOPES=
GRAPH_SENDER_UPN=
# SMS gateway (generic HTTP POST adapter).
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# --- M0.5 Document store: SharePoint adapter (dormant until set) ---
# Graph Sites/Drives target for the SharePoint storage adapter.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# --- M1.9 Offer e-signature adapter (DORMANT — provider TBD) ---
# No concrete provider is wired yet; in-app recruiter-recorded acceptance works.
# When a provider is chosen (DocuSign / Adobe Sign / etc.), document its secrets
# here, e.g. ESIGN_PROVIDER, ESIGN_API_BASE, ESIGN_API_KEY, ESIGN_ACCOUNT_ID.
